# --- Telegram ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:replace-me
# Comma-separated numeric Telegram user IDs allowed to use the bot.
# Get yours by messaging @userinfobot. Everyone else is silently ignored.
ALLOWED_USER_IDS=123456789

# --- LLM (any OpenAI-compatible endpoint) ---
# Hugging Face router (default): token from
# https://huggingface.co/settings/tokens (needs "Inference Providers" permission).
# Model must support tool calling ON THE PINNED PROVIDER — check
# https://router.huggingface.co/v1/models ("supports_tools"). Default is
# multimodal (text+image) Gemma 4 MoE; gpt-oss-120b is a cheap text-only alternative.
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_API_KEY=hf_replace-me
LLM_MODEL=google/gemma-4-26B-A4B-it:novita
# LLM_MODEL=openai/gpt-oss-120b:deepinfra
# Local llama.cpp (llama-server exposes /v1):
# LLM_BASE_URL=http://127.0.0.1:8080/v1
# LLM_API_KEY=local
# LLM_MODEL=local
# Ollama (local server, OpenAI-compatible at :11434):
# Install: https://ollama.com/download
# Then: ollama pull gemma4:31b-cloud
# Start: ollama serve  (or `npm run ollama:up`)
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama        # Ollama ignores this; the OpenAI SDK requires something
# LLM_MODEL=gemma4:31b-cloud
# OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# --- Speech to text ---
# Backend: "whisper" (whisper.cpp, default) or "sherpa" (sherpa-onnx HTTP server).
# STT_BACKEND=sherpa
# Spoken language for transcription: "en", "de", ... or "auto" for detection.
# Locking the language improves accuracy on short clips. Empty = server default.
# STT_LANGUAGE=en

# whisper.cpp server (HTTP /inference endpoint, multipart upload).
# Vulkan build is the default on this machine; on Android/Termux use a CPU build instead.
WHISPER_URL=http://127.0.0.1:8178
# Model file in vendor/whisper.cpp/models/ used by `npm run whisper:up`.
# Accuracy ladder (slower but better): tiny < base < small < medium < large-v3-turbo.
# WHISPER_MODEL=ggml-base.bin

# sherpa-onnx HTTP server (POST /recognize, JSON body with base64 WAV).
# Faster than whisper on CPU; Zipformer streaming models work great on phones.
SHERPA_URL=http://127.0.0.1:8178
# Example launch (streaming Zipformer, English, ~140MB on disk):
#   sherpa-onnx --port=8178 \
#     --tokens=./sherpa-onnx-streaming-zipformer-en-2023-06-26/tokens.txt \
#     --encoder=./sherpa-onnx-streaming-zipformer-en-2023-06-26/encoder-epoch-99-avg-1.onnx \
#     --decoder=./sherpa-onnx-streaming-zipformer-en-2023-06-26/decoder-epoch-99-avg-1.onnx \
#     --joiner=./sherpa-onnx-streaming-zipformer-en-2023-06-26/joiner-epoch-99-avg-1.onnx

# --- Workspace: sandboxed directory for all file tools; a git repo with auto-commit ---
# Relative paths resolve against the project dir; use an ABSOLUTE path outside the
# project (as below) to keep the workspace's git history fully separate.
WORKSPACE_DIR=/home/love/grandma-workspace

# --- Command allowlist for the run_command tool (comma-separated base names) ---
# ALLOWED_COMMANDS=ls,cat,head,tail,wc,find,rg,grep,pwd,git,mkdir,touch,date,file,stat,du,df,diff,which,echo,sort,uniq
